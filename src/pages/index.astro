---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeLink from "../components/ResumeLink.astro";
import ProjectSection from "../components/ProjectSection.astro";
import { profile } from "../data/profile";
import { categories } from "../data/categories";
import { getProjects } from "../lib/projects";
const projects = await getProjects();
---

<BaseLayout title="首页" description={profile.introduction}>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-main">
      <p class="eyebrow">
        <span class="small-dot" aria-hidden="true"></span>个人作品集{" "}
        <span class="eyebrow-divider">/</span> PORTFOLIO
      </p>
      <h1 id="intro-title">
        {profile.name ?? "姓名待补充"}
        <span class="title-dot" aria-hidden="true">
          .
        </span>
      </h1>
      <p class="profile-english" lang="en">
        {profile.englishName}
      </p>
      <p class="hero-introduction">
        {profile.introduction ?? "个人介绍待补充"}
      </p>
      <p class="profile-approach">{profile.approach}</p>
      <ul class="profile-highlights" aria-label="核心能力概括">
        {profile.highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <div class="hero-actions">
        <a class="button" href="/projects/">
          查看项目 <span aria-hidden="true">↗</span>
        </a>
        <a href={profile.github} target="_blank" rel="noopener">
          GitHub ↗
        </a>
        <ResumeLink />
      </div>
    </div>
    <div class="hero-index" aria-label="项目方向">
      <span class="eyebrow">项目索引</span>
      {categories.map((c) => (
        <a href={`#${c.id}`}>
          <span>{c.number}</span>
          {c.name}
          <span aria-hidden="true">↘</span>
        </a>
      ))}
    </div>
  </section>
  <ProjectSection
    category={categories[0]}
    projects={projects.filter(
      (p) => p.data.category === "ai" && p.data.featured,
    )}
  />
  <div class="secondary-projects">
    {categories.slice(1).map((category) => (
      <ProjectSection
        category={category}
        projects={projects.filter(
          (p) => p.data.category === category.id && p.data.featured,
        )}
        compact
      />
    ))}
  </div>
  <div class="home-closing">
    <p>更多项目与个人背景</p>
    <div>
      <a class="text-link" href="/projects/">
        浏览全部项目 ↗
      </a>
      <a class="text-link" href="/about/">
        关于我 ↗
      </a>
    </div>
  </div>
</BaseLayout>
