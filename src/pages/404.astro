---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到" noindex>
  <section class="page-heading error-page">
    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h1>
      这里还没有内容<span class="title-dot">.</span>
    </h1>
    <p>页面可能已移动，或链接地址有误。</p>
    <div class="hero-actions">
      <a class="button" href="/">
        返回首页 ↗
      </a>
      <a class="text-link" href="/projects/">
        浏览项目
      </a>
    </div>
  </section>
</BaseLayout>
