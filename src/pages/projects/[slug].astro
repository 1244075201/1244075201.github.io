---
import { render, type CollectionEntry } from "astro:content";
import { getProjects } from "../../lib/projects";
import { getTopics } from "../../lib/topics";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import EvidenceFigure from "../../components/EvidenceFigure.astro";
import DemoPlayer from "../../components/DemoPlayer.astro";
import TopicCard from "../../components/TopicCard.astro";
import ProjectOverviewExtras from "../../components/ProjectOverviewExtras.astro";
export async function getStaticPaths() {
  return (await getProjects())
    .filter((p) => p.data.display === "case-study")
    .map((project) => ({
      params: { slug: project.data.slug },
      props: { project },
    }));
}
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const p = project.data;
const topics = await getTopics(p.slug);
const { Content } = await render(project);
---

<ProjectLayout project={project}>
  {p.slug === "vr-dnd" && p.demoAsset && (
    <section id="demo" class="demo-section">
      <h2>Gameplay · 战斗片段精选</h2>
      <DemoPlayer asset={p.demoAsset} />
    </section>
  )}
  {p.heroAsset && p.slug !== "vr-dnd" && p.category !== "lab" && (
    <EvidenceFigure asset={p.heroAsset} priority />
  )}
  <article class="prose overview-copy">
    <Content />
  </article>
  <ProjectOverviewExtras project={p.slug} />
  {p.category === "lab" && p.heroAsset && (
    <section class="visual-section">
      <h2>Working Product · 实际工作台</h2>
      <EvidenceFigure asset={p.heroAsset} />
    </section>
  )}
  {topics.length > 0 && (
    <section class="explore-section">
      <div class="section-intro">
        <p class="eyebrow">EXPLORE THE PROJECT</p>
        <h2>选择一个主题，继续深入</h2>
      </div>
      <div class="topic-grid">
        {topics.map((topic) => (
          <TopicCard topic={topic} />
        ))}
      </div>
    </section>
  )}
  {p.demoAsset && p.slug !== "vr-dnd" && (
    <section id="demo" class="demo-section">
      <div class="section-intro">
        <p class="eyebrow">REAL EVIDENCE</p>
        <h2>
          {p.slug === "llm-npc-agent"
            ? "Uncut Interaction Demo"
            : "真实问答演示"}
        </h2>
        <p>
          {p.slug === "llm-npc-agent"
            ? "输入、等待、回复和记忆更新，保留完整交互过程。"
            : "从输入具体问题，到显示回答与依据的完整过程。"}
        </p>
      </div>
      <DemoPlayer asset={p.demoAsset} />
    </section>
  )}
  {p.slug === "vr-dnd" && (
    <details class="disclosure full-gameplay">
      <summary>观看完整演示 · 12分44秒 / 4 个连续部分</summary>
      <p class="source-note">
        按原片顺序分段，未经加速。分段边界是播放组织方式，不代表独立玩法章节。
      </p>
      <div class="full-video-grid">
        {[1, 2, 3, 4].map((i) => (
          <section>
            <h3>第 {i} 部分 / 4</h3>
            <DemoPlayer asset={`vr-part-${i}`} />
          </section>
        ))}
      </div>
    </details>
  )}
  {p.slug === "llm-npc-agent" && (
    <aside class="reference-note">
      <strong>Previous Work / 环境来源</strong>
      <p>
        本项目基于 Generative Agents / Smallville 环境扩展，重点为 Persistent
        Context 与 NPC 交互机制。
      </p>
      <a href="https://arxiv.org/abs/2304.03442" target="_blank" rel="noopener">
        Generative Agents: Interactive Simulacra of Human Behavior — Park et
        al., 2023 ↗
      </a>
    </aside>
  )}
</ProjectLayout>
