---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeLink from "../components/ResumeLink.astro";
import { profile } from "../data/profile";
---

<BaseLayout title="关于我" description={profile.introduction}>
  <header class="page-heading profile-heading">
    <p class="eyebrow">ABOUT / 关于我</p>
    <h1>
      {profile.name ?? "姓名待补充"}
      <span class="title-dot">.</span>
    </h1>
    <p class="profile-english" lang="en">
      {profile.englishName}
    </p>
    <p class="profile-about">{profile.about}</p>
  </header>
  <section class="capabilities" aria-labelledby="capabilities-title">
    <h2 id="capabilities-title">核心能力</h2>
    <div class="capability-grid">
      {profile.capabilities.map((group) => (
        <section class="capability-group">
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <ul>
            {group.keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <div class="profile-details">
    <section class="profile-links">
      <h2>教育背景</h2>
      <ul class="education-list">
        {profile.education.map((item) => (
          <li>
            <h3>{item.school}</h3>
            <p>
              {item.major} · {item.degree}
            </p>
            <p class="education-period">{item.period}</p>
          </li>
        ))}
      </ul>
    </section>
    <section class="profile-links">
      <h2>联系与简历</h2>
      <dl class="contact-list">
        {profile.phone && (
          <div>
            <dt>手机</dt>
            <dd>
              <a href={`tel:${profile.phone}`}>{profile.phone}</a>
            </dd>
          </div>
        )}
        {profile.email && (
          <div>
            <dt>邮箱</dt>
            <dd>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
            </dd>
          </div>
        )}
        {profile.wechat && (
          <div>
            <dt>微信</dt>
            <dd class="contact-value">{profile.wechat}</dd>
          </div>
        )}
      </dl>
      <div class="about-links">
        <a
          class="text-link"
          href={profile.github}
          target="_blank"
          rel="noopener"
        >
          GitHub ↗
        </a>
        <ResumeLink />
      </div>
    </section>
  </div>
  <div class="home-closing">
    <p>通过项目了解更多</p>
    <a class="text-link" href="/projects/">
      查看全部项目 ↗
    </a>
  </div>
</BaseLayout>
