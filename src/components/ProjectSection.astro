---
import type { CollectionEntry } from "astro:content";
import { categories } from "../data/categories";
import ProjectCard from "./ProjectCard.astro";
import GameGallery from "./GameGallery.astro";
interface Props {
  category: (typeof categories)[number];
  projects: CollectionEntry<"projects">[];
  compact?: boolean;
}
const { category, projects, compact = false } = Astro.props;
const cases = projects.filter((p) => p.data.display === "case-study");
const gallery = projects.filter((p) => p.data.display === "gallery");
---

<section
  id={category.id}
  class:list={["project-section", { "secondary-section": compact }]}
  aria-labelledby={`heading-${category.id}`}
>
  <div class="section-heading">
    <div>
      <span class="section-number">{category.number}</span>
      <h2 id={`heading-${category.id}`}>{category.name}</h2>
    </div>
    <p>{category.description}</p>
  </div>
  <div
    class:list={[
      "project-grid",
      {
        "compact-grid": compact,
        "featured-game-grid": category.id === "games" && !compact,
      },
    ]}
  >
    {cases.map((project) => (
      <ProjectCard project={project} compact={compact} />
    ))}
  </div>
  {gallery.length > 0 && <GameGallery projects={gallery} />}
</section>
