---
import "../styles/global.css";
import { profile } from "../data/profile";
import ResumeLink from "../components/ResumeLink.astro";
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = "个人作品集，收录 AI 与 Agent、游戏与交互、产品实验室三个方向的项目。",
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "首页" },
  { href: "/projects/", label: "项目" },
  { href: "/about/", label: "关于我" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 个人作品集</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>
    <header class="site-header container">
      <a class="brand" href="/" aria-label="个人作品集首页">
        <span class="brand-mark" aria-hidden="true">
          p<span>.</span>
        </span>
        <span>个人作品集</span>
      </a>
      <nav aria-label="主导航">
        {nav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={
              (href === "/" ? path === "/" : path.startsWith(href))
                ? "page"
                : undefined
            }
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="header-links">
        <ResumeLink />
        <a href={profile.github} target="_blank" rel="noopener">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <div>
        <a class="footer-title" href="/">
          个人作品集
        </a>
        <p>AI 与 Agent / 游戏与交互 / 产品实验室</p>
      </div>
      <div class="footer-links">
        <a href="/projects/">全部项目</a>
        <a href="/about/">关于我</a>
        <a href={profile.github} target="_blank" rel="noopener">
          GitHub ↗
        </a>
        <ResumeLink />
      </div>
      <span class="edition">PORTFOLIO · V0.2</span>
    </footer>
  </body>
</html>
